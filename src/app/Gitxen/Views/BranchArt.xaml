<UserControl
    x:Class="Gitxen.Views.BranchArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <!--
            A fade-in when the illustration appears, and no motion after that. It used to drift and
            breathe for as long as it was on screen, which measured about 1.4% of a 12-core machine
            around the clock: WinUI redraws the whole scaled illustration every frame, even for a
            translate. Half a second of fade is the whole cost now.
        -->
        <Storyboard x:Key="Arrival">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <!--
            An abstract background illustration: soft colour washes and flowing branch-like curves
            with commit-node dots, in the brand hues, filling the empty right side of Home. Full
            height, behind everything, and faint enough that content scrolling over it stays
            readable — each element carries its own low opacity rather than one flat value, so the
            washes stay barely-there while the lines keep a hint of definition.
        -->
        <Viewbox HorizontalAlignment="Right" VerticalAlignment="Stretch" Stretch="Uniform"
                 IsHitTestVisible="False">
            <Canvas Width="720" Height="1000">

                <!-- Soft colour washes for depth. Each fades to a transparent version of its own
                     hue so the edge dissolves instead of greying out; the mid stop eases the
                     falloff, and they are kept large and very faint because a small, stronger
                     radial shows visible banding rings on the dark theme. -->
                <Ellipse x:Name="WashBlue" Width="760" Height="760" Canvas.Left="280" Canvas.Top="-280" Opacity="0.045">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#58A6FF" />
                            <GradientStop Offset="0.55" Color="#5958A6FF" />
                            <GradientStop Offset="1" Color="#0058A6FF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="WashPurple" Width="680" Height="680" Canvas.Left="220" Canvas.Top="540" Opacity="0.045">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#A874FF" />
                            <GradientStop Offset="0.55" Color="#59A874FF" />
                            <GradientStop Offset="1" Color="#00A874FF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="WashIndigo" Width="480" Height="480" Canvas.Left="50" Canvas.Top="250" Opacity="0.035">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#808DFF" />
                            <GradientStop Offset="0.55" Color="#59808DFF" />
                            <GradientStop Offset="1" Color="#00808DFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- The curves and their nodes drift together — one layer, one transform — so the
                     nodes never slide off their lines. -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="CurveDrift" />
                    </Canvas.RenderTransform>

                    <!-- The main line, weaving top to bottom through the fork point at 560,520. -->
                    <Path Data="M 600,-30 C 520,150 660,330 560,520 C 470,690 640,850 560,1040"
                          Stroke="#58A6FF" StrokeThickness="3" Opacity="0.13"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <!-- A second line running loosely alongside it. -->
                    <Path Data="M 680,30 C 620,200 740,360 660,540 C 600,690 720,850 680,1040"
                          Stroke="#A874FF" StrokeThickness="3" Opacity="0.11"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <!-- A branch peeling off the fork point towards the lower left. -->
                    <Path Data="M 560,520 C 500,620 520,700 430,780 C 370,835 390,920 330,990"
                          Stroke="#808DFF" StrokeThickness="3" Opacity="0.11"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <!-- A short dotted branch drifting into the middle space. -->
                    <Path Data="M 585,260 C 500,320 520,390 420,440"
                          Stroke="#58A6FF" StrokeThickness="3" Opacity="0.11"
                          StrokeDashArray="0.1 4" StrokeDashCap="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <!-- Commit nodes: filled at the fork, rings at the branch tips, all centred on
                         curve endpoints so they sit exactly on their lines. -->
                    <Ellipse Width="16" Height="16" Canvas.Left="552" Canvas.Top="512"
                             Fill="#808DFF" Opacity="0.16" />
                    <Ellipse Width="14" Height="14" Canvas.Left="413" Canvas.Top="433"
                             Stroke="#58A6FF" StrokeThickness="3" Opacity="0.14" />
                    <Ellipse Width="14" Height="14" Canvas.Left="323" Canvas.Top="983"
                             Stroke="#808DFF" StrokeThickness="3" Opacity="0.14" />
                    <Ellipse Width="12" Height="12" Canvas.Left="654" Canvas.Top="534"
                             Fill="#A874FF" Opacity="0.14" />
                    <Ellipse Width="10" Height="10" Canvas.Left="585" Canvas.Top="255"
                             Fill="#58A6FF" Opacity="0.14" />
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
