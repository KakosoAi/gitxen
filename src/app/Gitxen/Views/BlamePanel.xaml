<UserControl
    x:Class="Gitxen.Views.BlamePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Gitxen.ViewModels"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <Grid RowDefinitions="Auto,*">

        <!-- Which file, and as of when: one left-aligned run, like the diff panel's header. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="12,8,12,8"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE77B;" FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind Model.Title, Mode=OneWay}" Style="{StaticResource CodeTextStyle}"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       MaxWidth="520" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Model.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <ProgressRing Width="14" Height="14" VerticalAlignment="Center"
                          IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind Model.Rows, Mode=OneWay}"
                  SelectedItem="{x:Bind Model.Selected, Mode=TwoWay}"
                  SelectionMode="Single" Padding="8,0,8,8"
                  Visibility="{x:Bind Model.RowsVisibility, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource DiffLineItemStyle}"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BlameRow">
                    <!-- The code is the star column and comes last: a column placed after a star-sized
                         one is arranged off the right of the screen here. -->
                    <Grid Height="20" ColumnDefinitions="72,150,96,44,*" ColumnSpacing="8" Padding="4,0,4,0"
                          Background="{x:Bind Background}"
                          ToolTipService.ToolTip="{x:Bind Tooltip}"
                          RightTapped="Row_RightTapped" DoubleTapped="Row_DoubleTapped">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Show this commit in history" Click="ShowCommit_Click" />
                                <MenuFlyoutItem Text="History of this line" Click="LineHistory_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE81C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy commit hash" Click="CopyHash_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <TextBlock Text="{x:Bind Hash}" Style="{StaticResource HashTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Author}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Age}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind LineNumber}" Style="{StaticResource CodeTextStyle}"
                                   FontSize="{StaticResource FontSizeCaption}" Opacity="0.45"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Text}" Style="{StaticResource CodeTextStyle}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Nothing to show: no file, a deleted file, an empty file, or git refused. -->
        <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center" Padding="24,0,24,0"
                    Visibility="{x:Bind Model.MessageVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE77B;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="{x:Bind Model.Message, Mode=OneWay}" Style="{StaticResource EmptyStateBodyStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
