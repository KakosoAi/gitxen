<UserControl
    x:Class="Gitxen.Views.AddRepositoriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Gitxen.Views">

    <!-- An overlay rather than a ContentDialog, for the same reason as the setup wizard: the list of
         what a scan found needs more room than a dialog's content area gives. -->
    <Grid Background="{ThemeResource SmokeFillColorDefaultBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>

        <Border MaxWidth="920" MaxHeight="760" Margin="32"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10">

            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Padding="28,24,28,16" Spacing="2"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Add repositories" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Find the repositories on this computer and put them on Home. Nothing is opened or changed." />
                </StackPanel>

                <views:RepositoryImporter Grid.Row="1" x:Name="Importer" Margin="28,16,28,16"
                                          SelectionChanged="Importer_SelectionChanged" />

                <!-- A single left-aligned run of buttons, as everywhere in this app. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Padding="28,16,28,20"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Button x:Name="AddButton" Content="Add" Click="Add_Click" MinWidth="120"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                    <Button Content="Cancel" Click="Cancel_Click" MinWidth="96" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
