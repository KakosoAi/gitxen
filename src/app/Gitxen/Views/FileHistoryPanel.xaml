<UserControl
    x:Class="Gitxen.Views.FileHistoryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Gitxen.ViewModels"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="12,8,12,8"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE81C;" FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind Model.Title, Mode=OneWay}" Style="{StaticResource CodeTextStyle}"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       MaxWidth="520" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Model.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <Button Content="Show in history" Click="ShowInHistory_Click"
                    IsEnabled="{x:Bind Model.HasSelection, Mode=OneWay}" />
            <ProgressRing Width="14" Height="14" VerticalAlignment="Center"
                          IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind Model.Rows, Mode=OneWay}"
                  SelectedItem="{x:Bind Model.Selected, Mode=TwoWay}"
                  SelectionMode="Single" Padding="8,0,8,8"
                  Visibility="{x:Bind Model.RowsVisibility, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource DiffLineItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileHistoryRow">
                    <Grid Height="26" ColumnDefinitions="84,110,170,*" ColumnSpacing="10" Padding="8,0,8,0"
                          DoubleTapped="Row_DoubleTapped" RightTapped="Row_RightTapped">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Show in history" Click="ShowInHistory_Click" />
                                <MenuFlyoutItem Text="Copy commit hash" Click="CopyHash_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <TextBlock Text="{x:Bind ShortHash}" Style="{StaticResource HashTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Age}" Style="{StaticResource SecondaryTextStyle}"
                                   ToolTipService.ToolTip="{x:Bind Date}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Author}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Subject}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center" Padding="24,0,24,0"
                    Visibility="{x:Bind Model.MessageVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="{x:Bind Model.Message, Mode=OneWay}" Style="{StaticResource EmptyStateBodyStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
