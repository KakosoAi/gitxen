<Window
    x:Class="Gitxen.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Width="520" Height="300" CornerRadius="10"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

        <Grid.Resources>
            <!--
                The whole thing is one pass, about a second and a half: the washes fade up, the
                branch draws itself from the top down, its nodes land on the line in the order the
                line reaches them, and the wordmark rises under it. Every animation here is on a
                property the compositor owns — opacity and transforms — except the stroke dash,
                which is cheap on a single short path.
            -->
            <Storyboard x:Key="Intro">
                <DoubleAnimation Storyboard.TargetName="Washes" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.5" />

                <!-- Draws the line: the dash is the line's own length, offset from fully hidden. -->
                <DoubleAnimation Storyboard.TargetName="Trunk" Storyboard.TargetProperty="StrokeDashOffset"
                                 From="100" To="0" BeginTime="0:0:0.1" Duration="0:0:0.85">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Trunk" Storyboard.TargetProperty="Opacity"
                                 From="0" To="0.95" BeginTime="0:0:0.1" Duration="0:0:0.25" />

                <DoubleAnimation Storyboard.TargetName="Branch" Storyboard.TargetProperty="StrokeDashOffset"
                                 From="100" To="0" BeginTime="0:0:0.45" Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Branch" Storyboard.TargetProperty="Opacity"
                                 From="0" To="0.85" BeginTime="0:0:0.45" Duration="0:0:0.25" />

                <!-- Nodes: each lands as the line reaches it, scaling up from its own centre. -->
                <DoubleAnimation Storyboard.TargetName="NodeOne" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetName="NodeOneScale" Storyboard.TargetProperty="ScaleX"
                                 From="0.2" To="1" BeginTime="0:0:0.35" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="NodeOneScale" Storyboard.TargetProperty="ScaleY"
                                 From="0.2" To="1" BeginTime="0:0:0.35" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <DoubleAnimation Storyboard.TargetName="NodeTwo" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" BeginTime="0:0:0.62" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetName="NodeTwoScale" Storyboard.TargetProperty="ScaleX"
                                 From="0.2" To="1" BeginTime="0:0:0.62" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="NodeTwoScale" Storyboard.TargetProperty="ScaleY"
                                 From="0.2" To="1" BeginTime="0:0:0.62" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <DoubleAnimation Storyboard.TargetName="NodeThree" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" BeginTime="0:0:0.95" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetName="NodeThreeScale" Storyboard.TargetProperty="ScaleX"
                                 From="0.2" To="1" BeginTime="0:0:0.95" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="NodeThreeScale" Storyboard.TargetProperty="ScaleY"
                                 From="0.2" To="1" BeginTime="0:0:0.95" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- The wordmark rises into place as the graphic finishes. -->
                <DoubleAnimation Storyboard.TargetName="Wordmark" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.45" />
                <DoubleAnimation Storyboard.TargetName="WordmarkRise" Storyboard.TargetProperty="Y"
                                 From="14" To="0" BeginTime="0:0:0.55" Duration="0:0:0.55">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <DoubleAnimation Storyboard.TargetName="Tagline" Storyboard.TargetProperty="Opacity"
                                 From="0" To="0.6" BeginTime="0:0:0.75" Duration="0:0:0.35" />
                <DoubleAnimation Storyboard.TargetName="Credit" Storyboard.TargetProperty="Opacity"
                                 From="0" To="0.5" BeginTime="0:0:0.9" Duration="0:0:0.35" />
            </Storyboard>

            <!-- Leaving: short, and started only once the window is actually ready. -->
            <Storyboard x:Key="Outro">
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.22" />
                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                 To="1.02" Duration="0:0:0.22" />
                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                 To="1.02" Duration="0:0:0.22" />
            </Storyboard>
        </Grid.Resources>

        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" CenterX="260" CenterY="150" />
        </Grid.RenderTransform>

        <!--
            The same illustration language as Home: soft colour washes behind branch-like curves
            with commit nodes sitting on them. Here it is the whole picture rather than a watermark,
            so the opacities are far higher and the curve is short enough to draw in one gesture.
        -->
        <Canvas x:Name="Washes" Opacity="0">
            <Ellipse Width="360" Height="360" Canvas.Left="-90" Canvas.Top="-140" Opacity="0.20">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#58A6FF" Offset="0" />
                        <GradientStop Color="#0058A6FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="340" Height="340" Canvas.Left="300" Canvas.Top="100" Opacity="0.20">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A874FF" Offset="0" />
                        <GradientStop Color="#00A874FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="260" Height="260" Canvas.Left="120" Canvas.Top="-60" Opacity="0.14">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#808DFF" Offset="0" />
                        <GradientStop Color="#00808DFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Canvas Width="520" Height="300">
            <!--
                StrokeDashArray is in multiples of the stroke thickness: 100 at thickness 3 is a
                300px dash followed by a 300px gap, comfortably longer than either curve. Starting
                with the offset at the same 100 puts the whole line inside the gap, and animating the
                offset to zero walks the visible part along the curve from its start to its end.
            -->
            <Path x:Name="Trunk" Opacity="0"
                  Data="M 150,40 C 130,95 175,120 168,152 C 161,186 196,205 188,248"
                  Stroke="#58A6FF" StrokeThickness="3"
                  StrokeDashArray="100 100" StrokeDashOffset="100"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <Path x:Name="Branch" Opacity="0"
                  Data="M 168,152 C 200,170 234,150 250,120 C 262,98 284,92 306,96"
                  Stroke="#A874FF" StrokeThickness="3"
                  StrokeDashArray="100 100" StrokeDashOffset="100"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <!-- Each node is centred on a point the curve above actually passes through. -->
            <Ellipse x:Name="NodeOne" Width="14" Height="14" Canvas.Left="161" Canvas.Top="145"
                     Fill="#808DFF" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="NodeOneScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="NodeTwo" Width="12" Height="12" Canvas.Left="300" Canvas.Top="90"
                     Stroke="#A874FF" StrokeThickness="3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="NodeTwoScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="NodeThree" Width="12" Height="12" Canvas.Left="182" Canvas.Top="242"
                     Stroke="#58A6FF" StrokeThickness="3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="NodeThreeScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,44,0" Spacing="6">
            <TextBlock x:Name="Wordmark" Text="Gitxen" Opacity="0"
                       FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Right">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="WordmarkRise" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Tagline" Text="A git client for Windows" Opacity="0"
                       FontSize="13" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Which build this is, and whose it is. The version comes from the assembly rather
                 than the markup so the splash cannot claim a version the build does not have. -->
            <StackPanel x:Name="Credit" Opacity="0" Spacing="1" Margin="0,10,0,0"
                        HorizontalAlignment="Right">
                <TextBlock Text="{x:Bind VersionText}" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="by Kakoso" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
