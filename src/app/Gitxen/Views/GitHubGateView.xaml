<UserControl
    x:Class="Gitxen.Views.GitHubGateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        What a GitHub section shows in place of itself when it cannot: while it finds out, and when the
        answer is that gh is missing, not signed in, or cannot see this repository. It says what is
        wrong in words and offers the one thing that fixes it, so a section that has nothing to show is
        never an unexplained blank.
    -->
    <Grid>
        <ProgressRing IsActive="True" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{x:Bind GitHub.CheckingVisibility, Mode=OneWay}" />

        <StackPanel Spacing="10" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind GitHub.GateVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE753;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="{x:Bind GitHub.GateTitle, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}" />
            <TextBlock Text="{x:Bind GitHub.GateMessage, Mode=OneWay}" Style="{StaticResource EmptyStateBodyStyle}"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Visibility="{x:Bind GitHub.GateActionsVisibility, Mode=OneWay}">
                <Button Content="Check again" Click="Recheck_Click" Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Open Settings" Click="Settings_Click" />
                <HyperlinkButton Content="Get the GitHub CLI" NavigateUri="https://cli.github.com"
                                 Visibility="{x:Bind GitHub.GetGhVisibility, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
