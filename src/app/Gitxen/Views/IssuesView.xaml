<views:RepositoryPage
    x:Class="Gitxen.Views.IssuesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gitxen.Controls"
    xmlns:conv="using:Gitxen.Converters"
    xmlns:vm="using:Gitxen.ViewModels"
    xmlns:views="using:Gitxen.Views">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="20,16,20,10" Spacing="10"
                    Visibility="{x:Bind Tab.GitHub.ContentVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
                <StackPanel Spacing="2">
                    <TextBlock Text="Issues" Style="{StaticResource PageTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind Tab.GitHub.RepositoryName, Mode=OneWay}"
                                   Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center" />
                        <views:GitHubAccountButton Model="{x:Bind Tab.GitHub, Mode=OneWay}"
                                                   AccountChanged="Account_Changed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="NewIssue_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="New issue" />
                        </StackPanel>
                    </Button>
                    <Button Click="Refresh_Click" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                    <Button Click="OpenList_Click" AutomationProperties.Name="Open on GitHub"
                            ToolTipService.ToolTip="Open the list on GitHub">
                        <FontIcon Glyph="&#xE774;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <ComboBox MinWidth="120" VerticalAlignment="Center" AutomationProperties.Name="Show"
                          SelectedIndex="{x:Bind Tab.GitHub.Issues.StateIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Open" />
                    <ComboBoxItem Content="Closed" />
                    <ComboBoxItem Content="All" />
                </ComboBox>
                <ToggleButton Content="Mine" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Only issues you opened"
                              IsChecked="{x:Bind Tab.GitHub.Issues.MineOnly, Mode=TwoWay}" />
                <TextBox Width="260" PlaceholderText="Filter by title, number, label or author"
                         VerticalAlignment="Center"
                         Text="{x:Bind Tab.GitHub.Issues.Search, Mode=TwoWay}" />
                <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                              IsActive="{x:Bind Tab.GitHub.Issues.IsLoading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Tab.GitHub.Issues.CountText, Mode=OneWay}"
                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <views:GitHubGateView Grid.RowSpan="2" GitHub="{x:Bind Tab.GitHub, Mode=OneWay}"
                              Rechecked="Gate_Rechecked" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16"
              Visibility="{x:Bind Tab.GitHub.ContentVisibility, Mode=OneWay}">

            <Grid Margin="20,0,0,0">
                <Border Style="{StaticResource CardBorderStyle}">
                    <ListView ItemsSource="{x:Bind Tab.GitHub.Issues.Items, Mode=OneWay}"
                              SelectedItem="{x:Bind Tab.GitHub.Issues.Selected, Mode=TwoWay}"
                              SelectionMode="Single" Padding="4"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IssueRow">
                                <Grid ColumnDefinitions="92,*" ColumnSpacing="12" Padding="2,4">
                                    <Border VerticalAlignment="Top" CornerRadius="10" Padding="0,2"
                                            Background="{x:Bind StateBrush}">
                                        <TextBlock Text="{x:Bind StateText}" HorizontalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeCaption}" Foreground="White" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="{x:Bind NumberText}" Style="{StaticResource HashTextStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Meta}" FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind UpdatedTooltip}" />
                                        <views:LabelStrip Labels="{x:Bind Labels}" Visibility="{x:Bind LabelsVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{x:Bind Tab.GitHub.Issues.EmptyVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE946;" Style="{StaticResource EmptyStateGlyphStyle}" />
                    <TextBlock Text="{x:Bind Tab.GitHub.Issues.EmptyText, Mode=OneWay}"
                               Style="{StaticResource EmptyStateBodyStyle}" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Grid>

            <controls:PaneSplitter Grid.Column="1" Orientation="Vertical" Invert="True"
                                   Minimum="380" Maximum="1100" Target="{x:Bind DetailPane}"
                                   Visibility="{x:Bind Tab.GitHub.Issues.SelectionVisibility, Mode=OneWay}" />

            <Grid Grid.Column="2" x:Name="DetailPane" Width="560" RowDefinitions="Auto,*" Margin="0,0,16,0"
                  Visibility="{x:Bind Tab.GitHub.Issues.SelectionVisibility, Mode=OneWay}">

                <ProgressBar Grid.Row="0" IsIndeterminate="True" VerticalAlignment="Top"
                             Visibility="{x:Bind conv:Show.If(Tab.GitHub.Issues.IsDetailLoading), Mode=OneWay}" />

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12,16,4"
                        Visibility="{x:Bind Tab.GitHub.Issues.DetailVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Tab.GitHub.Issues.Detail.Header.Title, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border VerticalAlignment="Center" CornerRadius="10" Padding="10,2"
                                    Background="{x:Bind Tab.GitHub.Issues.Detail.Header.StateBrush, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Tab.GitHub.Issues.Detail.Header.StateText, Mode=OneWay}"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Bind Tab.GitHub.Issues.Detail.Opened, Mode=OneWay}"
                                       VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <views:LabelStrip Labels="{x:Bind Tab.GitHub.Issues.Detail.Header.Labels, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Visibility="{x:Bind Tab.GitHub.Issues.Detail.Header.AssigneesVisibility, Mode=OneWay}">
                                <Run Text="Assigned to " /><Run Text="{x:Bind Tab.GitHub.Issues.Detail.Header.Assignees, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Visibility="{x:Bind Tab.GitHub.Issues.Detail.Header.MilestoneVisibility, Mode=OneWay}">
                                <Run Text="Milestone " /><Run Text="{x:Bind Tab.GitHub.Issues.Detail.Header.Milestone, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False"
                                    HorizontalAlignment="Left">
                            <AppBarButton Label="Comment…" Click="Comment_Click">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE90A;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Close…" Click="Close_Click"
                                          Visibility="{x:Bind conv:Show.If(Tab.GitHub.Issues.Detail.CanClose), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Reopen" Click="Reopen_Click"
                                          Visibility="{x:Bind conv:Show.If(Tab.GitHub.Issues.Detail.CanReopen), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE777;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Open on GitHub" Click="OpenOnGitHub_Click">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Copy link" Click="CopyLink_Click">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Visibility="{x:Bind Tab.GitHub.Issues.DetailVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12" Padding="0,8,12,16">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,12">
                            <TextBlock Text="{x:Bind Tab.GitHub.Issues.Detail.Body, Mode=OneWay}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Border>

                        <ItemsControl ItemsSource="{x:Bind Tab.GitHub.Issues.Detail.Comments, Mode=OneWay}"
                                      Visibility="{x:Bind Tab.GitHub.Issues.Detail.CommentsVisibility, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CommentRow">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Author}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind When}" Style="{StaticResource SecondaryTextStyle}"
                                                           ToolTipService.ToolTip="{x:Bind WhenTooltip}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</views:RepositoryPage>
