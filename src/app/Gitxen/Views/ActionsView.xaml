<views:RepositoryPage
    x:Class="Gitxen.Views.ActionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gitxen.Controls"
    xmlns:conv="using:Gitxen.Converters"
    xmlns:vm="using:Gitxen.ViewModels"
    xmlns:views="using:Gitxen.Views">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="20,16,20,10" Spacing="10"
                    Visibility="{x:Bind Tab.GitHub.ContentVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
                <StackPanel Spacing="2">
                    <TextBlock Text="Actions" Style="{StaticResource PageTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind Tab.GitHub.RepositoryName, Mode=OneWay}"
                                   Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center" />
                        <views:GitHubAccountButton Model="{x:Bind Tab.GitHub, Mode=OneWay}"
                                                   AccountChanged="Account_Changed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="RunWorkflow_Click" Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind conv:Show.If(Tab.GitHub.CanWrite), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="Run workflow" />
                        </StackPanel>
                    </Button>
                    <Button Click="Refresh_Click" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                    <Button Click="OpenList_Click" AutomationProperties.Name="Open on GitHub"
                            ToolTipService.ToolTip="Open Actions on GitHub">
                        <FontIcon Glyph="&#xE774;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <ToggleButton Content="This branch" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Only runs on the branch that is checked out"
                              IsChecked="{x:Bind Tab.GitHub.Actions.ThisBranchOnly, Mode=TwoWay}" />
                <TextBox Width="260" PlaceholderText="Filter by title, workflow, branch or event"
                         VerticalAlignment="Center"
                         Text="{x:Bind Tab.GitHub.Actions.Search, Mode=TwoWay}" />
                <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                              IsActive="{x:Bind Tab.GitHub.Actions.IsLoading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Tab.GitHub.Actions.CountText, Mode=OneWay}"
                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <views:GitHubGateView Grid.RowSpan="2" GitHub="{x:Bind Tab.GitHub, Mode=OneWay}"
                              Rechecked="Gate_Rechecked" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16"
              Visibility="{x:Bind Tab.GitHub.ContentVisibility, Mode=OneWay}">

            <Grid Margin="20,0,0,0">
                <Border Style="{StaticResource CardBorderStyle}">
                    <ListView ItemsSource="{x:Bind Tab.GitHub.Actions.Items, Mode=OneWay}"
                              SelectedItem="{x:Bind Tab.GitHub.Actions.Selected, Mode=TwoWay}"
                              SelectionMode="Single" Padding="4"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunRow">
                                <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="10" Padding="2,4">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconSizeMedium}"
                                              Foreground="{x:Bind Brush}" VerticalAlignment="Top" Margin="0,2,0,0"
                                              ToolTipService.ToolTip="{x:Bind OutcomeText}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Meta}" FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Age}" HorizontalAlignment="Right"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   ToolTipService.ToolTip="{x:Bind AgeTooltip}" />
                                        <TextBlock Text="{x:Bind DurationText}" HorizontalAlignment="Right"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{x:Bind Tab.GitHub.Actions.EmptyVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE768;" Style="{StaticResource EmptyStateGlyphStyle}" />
                    <TextBlock Text="{x:Bind Tab.GitHub.Actions.EmptyText, Mode=OneWay}"
                               Style="{StaticResource EmptyStateBodyStyle}" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Grid>

            <controls:PaneSplitter Grid.Column="1" Orientation="Vertical" Invert="True"
                                   Minimum="360" Maximum="1000" Target="{x:Bind DetailPane}"
                                   Visibility="{x:Bind Tab.GitHub.Actions.SelectionVisibility, Mode=OneWay}" />

            <Grid Grid.Column="2" x:Name="DetailPane" Width="520" RowDefinitions="Auto,*" Margin="0,0,16,0"
                  Visibility="{x:Bind Tab.GitHub.Actions.SelectionVisibility, Mode=OneWay}">

                <ProgressBar Grid.Row="0" IsIndeterminate="True" VerticalAlignment="Top"
                             Visibility="{x:Bind conv:Show.If(Tab.GitHub.Actions.IsDetailLoading), Mode=OneWay}" />

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12,16,4"
                        Visibility="{x:Bind Tab.GitHub.Actions.DetailVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Tab.GitHub.Actions.Detail.Header.Title, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind Tab.GitHub.Actions.Detail.Header.Glyph, Mode=OneWay}"
                                      FontSize="{StaticResource IconSizeMedium}"
                                      Foreground="{x:Bind Tab.GitHub.Actions.Detail.Header.Brush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Tab.GitHub.Actions.Detail.Header.OutcomeText, Mode=OneWay}"
                                       Foreground="{x:Bind Tab.GitHub.Actions.Detail.Header.Brush, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Tab.GitHub.Actions.Detail.Header.DurationText, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Tab.GitHub.Actions.Detail.Header.Meta, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                            <Run Text="Commit " /><Run Text="{x:Bind Tab.GitHub.Actions.Detail.Header.ShortSha, Mode=OneWay}" />
                        </TextBlock>

                        <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False"
                                    HorizontalAlignment="Left">
                            <AppBarButton Label="Re-run all" Click="RerunAll_Click"
                                          Visibility="{x:Bind conv:Show.If(Tab.GitHub.Actions.Detail.CanRerun), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Re-run failed" Click="RerunFailed_Click"
                                          Visibility="{x:Bind conv:Show.If(Tab.GitHub.Actions.Detail.CanRerunFailed), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE895;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Cancel run" Click="Cancel_Click"
                                          Visibility="{x:Bind conv:Show.If(Tab.GitHub.Actions.Detail.CanCancel), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Failed log" Click="FailedLog_Click"
                                          Visibility="{x:Bind conv:Show.If(Tab.GitHub.Actions.Detail.CanViewFailedLog), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE7BA;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Full log" Click="FullLog_Click"
                                          Visibility="{x:Bind conv:Show.If(Tab.GitHub.Actions.Detail.CanViewLog), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Open on GitHub" Click="OpenOnGitHub_Click">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Copy link" Click="CopyLink_Click">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Visibility="{x:Bind Tab.GitHub.Actions.DetailVisibility, Mode=OneWay}">
                    <StackPanel Spacing="10" Padding="0,8,12,16">

                        <!-- A run with no jobs says why, instead of leaving a blank. -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,12"
                                Visibility="{x:Bind Tab.GitHub.Actions.Detail.NoJobsVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Tab.GitHub.Actions.Detail.NoJobsText, Mode=OneWay}"
                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                        </Border>

                        <ItemsControl ItemsSource="{x:Bind Tab.GitHub.Actions.Detail.Jobs, Mode=OneWay}"
                                      Visibility="{x:Bind Tab.GitHub.Actions.Detail.JobsVisibility, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:JobRow">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconSizeMedium}"
                                                          Foreground="{x:Bind Brush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind DurationText}"
                                                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind Steps}" Margin="32,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StepRow">
                                                        <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8" Padding="0,2">
                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconSizeSmall}"
                                                                      Foreground="{x:Bind Brush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}"
                                                                       FontSize="{StaticResource FontSizeCaption}"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</views:RepositoryPage>
