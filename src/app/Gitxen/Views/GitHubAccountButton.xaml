<UserControl
    x:Class="Gitxen.Views.GitHubAccountButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Which signed-in gh account this repository is read as, and a menu to choose another. Quiet by
        design: it sits under the page title, where the repository's name is.
    -->
    <DropDownButton Padding="6,1,6,1" MinHeight="0" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="The GitHub account this repository is read and changed as"
                    AutomationProperties.Name="GitHub account">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE77B;" FontSize="{StaticResource IconSizeTiny}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind Model.AccountText, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <DropDownButton.Flyout>
            <MenuFlyout x:Name="AccountMenu" Placement="BottomEdgeAlignedLeft" Opening="AccountMenu_Opening" />
        </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>
