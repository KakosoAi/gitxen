<UserControl
    x:Class="Gitxen.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Gitxen.Models"
    xmlns:views="using:Gitxen.Views"
    xmlns:vm="using:Gitxen.ViewModels"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <!-- The repository list's sections: recently used, then each project, then the rest. -->
        <CollectionViewSource x:Key="SectionsSource" IsSourceGrouped="True" ItemsPath="Items" />

        <!--
            One repository, on one line: name, last commit, branch. The path is in the tooltip, and the
            row's menu button only shows on hover, so a long list reads as a list rather than as a
            column of buttons. Right-click opens the same menu.
        -->
        <DataTemplate x:Key="RepositoryRowTemplate" x:DataType="models:RecentRepository">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="10,7,6,7"
                  Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind Path}"
                  PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open" Click="OpenRecent_Click" Tag="{x:Bind}" />
                        <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" Tag="{x:Bind}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Move to project…" Click="MoveToGroup_Click" Tag="{x:Bind}" />
                        <MenuFlyoutItem Text="Remove from Gitxen" Click="RemoveRecent_Click" Tag="{x:Bind}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource IconSizeSmall}" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind LastCommit, Mode=OneWay}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Grid.Column="1" Text="Folder is missing or is no longer a repository"
                               FontStyle="Italic" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{x:Bind MissingVisibility, Mode=OneWay}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                <!-- What it is built with: a small badge each, its name, version and source in the tooltip. -->
                <ItemsControl ItemsSource="{x:Bind Technologies, Mode=OneWay}" VerticalAlignment="Center"
                              Visibility="{x:Bind TechnologiesVisibility, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TechBadge">
                            <Border CornerRadius="4" Padding="5,0,5,1" MinWidth="22" Background="{x:Bind Background}"
                                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                                <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{x:Bind Foreground}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border CornerRadius="4" Padding="8,2,8,3" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource IconSizeTiny}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Branch, Mode=OneWay}" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Opacity="0"
                        VerticalAlignment="Center" Tag="{x:Bind}"
                        AutomationProperties.Name="Repository options" ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="{StaticResource IconSizeSmall}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Open" Click="OpenRecent_Click" Tag="{x:Bind}" />
                            <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" Tag="{x:Bind}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Move to project…" Click="MoveToGroup_Click" Tag="{x:Bind}" />
                            <MenuFlyoutItem Text="Remove from Gitxen" Click="RemoveRecent_Click" Tag="{x:Bind}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The branch illustration, behind the whole page: faint enough for the list to sit on. -->
        <views:BranchArt x:Name="BackgroundArt" />

        <!--
            Home has one job: find a repository and open it. A slim toolbar (filter, and the actions as
            icons with their names in tooltips), the projects down the left, the repositories on the
            right. Settings are one click away on the toolbar rather than taking up the page.
        -->
        <Grid x:Name="MainContent" RowDefinitions="Auto,*">

            <Grid Padding="20,14,20,12" ColumnDefinitions="*,Auto" ColumnSpacing="16"
                  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <AutoSuggestBox x:Name="FilterBox" Width="440" HorizontalAlignment="Left"
                                PlaceholderText="Filter repositories by name, folder or branch"
                                QueryIcon="Filter" AutomationProperties.Name="Filter repositories"
                                TextChanged="Filter_TextChanged" QuerySubmitted="Filter_QuerySubmitted" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Width" Value="38" />
                            <Setter Property="Height" Value="34" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </StackPanel.Resources>

                    <Button Click="Open_Click" Style="{ThemeResource AccentButtonStyle}" Width="38" Height="34" Padding="0"
                            AutomationProperties.Name="Open repository" ToolTipService.ToolTip="Open repository (Ctrl+O)">
                        <FontIcon Glyph="&#xE8DA;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                    <Button Click="Clone_Click" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Clone from URL" ToolTipService.ToolTip="Clone from URL">
                        <FontIcon Glyph="&#xE896;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                    <Button Click="Init_Click" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="New repository" ToolTipService.ToolTip="New repository: workflow, .gitignore, licence, and GitHub">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                    <Button Click="Setup_Click" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Find repositories" ToolTipService.ToolTip="Find repositories on this computer">
                        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                    <Button Click="RefreshRecent_Click" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Read each repository's branch and last commit again">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>

                    <Border Width="1" Height="22" Margin="6,0" VerticalAlignment="Center"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Button Click="OpenGitConfig_Click" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Git configuration" ToolTipService.ToolTip="Git configuration: identity and defaults for every repository">
                        <FontIcon Glyph="&#xE9F5;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                    <Button Click="OpenAppSettings_Click" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Projects on the left, their repositories on the right. -->
            <Grid x:Name="ListArea" Grid.Row="1" ColumnDefinitions="220,*">

                <Grid RowDefinitions="*,Auto" Padding="10,12,8,12"
                      BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView x:Name="ProjectList" SelectionMode="Single"
                              SelectionChanged="ProjectList_SelectionChanged"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectRailItem">
                                <!-- A drop target too: drag a repository onto a project to move it. -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="8,6"
                                      Background="Transparent" AllowDrop="True" Tag="{x:Bind}"
                                      DragOver="Rail_DragOver" Drop="Rail_Drop">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Rename or restyle…" Click="EditGroup_Click"
                                                            Tag="{x:Bind Target}" Visibility="{x:Bind ProjectMenuVisibility}" />
                                            <MenuFlyoutItem Text="Delete project" Click="DeleteGroup_Click"
                                                            Tag="{x:Bind Target}" Visibility="{x:Bind ProjectMenuVisibility}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconSizeSmall}"
                                              VerticalAlignment="Center"
                                              Foreground="{x:Bind Accent}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="1" Click="NewGroup_Click" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6"
                            ToolTipService.ToolTip="Group repositories that are worked on together">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="New project" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Column="1">
                    <ListView x:Name="RepositoryList" Padding="12,4,16,16"
                              ItemsSource="{Binding Source={StaticResource SectionsSource}}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="Recent_ItemClick"
                              CanDragItems="True" DragItemsStarting="Repositories_DragItemsStarting"
                              ItemTemplate="{StaticResource RepositoryRowTemplate}"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderContainerStyle="{StaticResource StretchedGroupHeaderStyle}">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:HomeSection">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,14,0,4">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionCaptionStyle}" />
                                            <TextBlock Text="{x:Bind CountText}" VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>

                    <TextBlock x:Name="NoMatches" Visibility="Collapsed" Margin="24"
                               Style="{StaticResource PageSubtitleStyle}"
                               Text="No repository matches that filter." />
                </Grid>
            </Grid>

            <!-- No repositories yet: three ways to get one, and the illustration behind them. -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="24,0,24,80">
                <TextBlock Text="Start with a repository" HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           Style="{StaticResource PageSubtitleStyle}" FontSize="{StaticResource FontSizeBodyLarge}"
                           Text="Open one from disk, clone one from a URL, or let Gitxen find the ones already on this computer. You can also drop a folder onto the window." />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Click="Open_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8DA;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Open repository" />
                        </StackPanel>
                    </Button>
                    <Button Click="Clone_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Clone" />
                        </StackPanel>
                    </Button>
                    <Button Click="Setup_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Find repositories" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--
            Home's sub-pages. Swapped by visibility like every other section in the app, so a
            half-edited identity or a scroll position survives going back and forth. Each page
            carries its own title and scrolling; the strip here is only the way back.
        -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,12,20,0">
                <Button Click="BackToHome_Click" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Back to Home" ToolTipService.ToolTip="Back to Home">
                    <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSizeMedium}" />
                </Button>
                <TextBlock Text="Home" VerticalAlignment="Center"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <views:SettingsView Grid.Row="1" x:Name="AppSettings" />
        </Grid>

        <Grid x:Name="GitConfigPage" Visibility="Collapsed" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,12,20,0">
                <Button Click="BackToHome_Click" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Back to Home" ToolTipService.ToolTip="Back to Home">
                    <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSizeMedium}" />
                </Button>
                <TextBlock Text="Home" VerticalAlignment="Center"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <views:GitConfigView Grid.Row="1" x:Name="GlobalConfig" />
        </Grid>
    </Grid>
</UserControl>
