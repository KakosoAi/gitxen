<UserControl
    x:Class="Gitxen.Views.InteractiveRebasePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Gitxen.ViewModels">

    <StackPanel Spacing="10" Width="620">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Opacity="0.8"
                   Text="Newest at the top. Drag a commit to move it; choose what happens to each. Squash and fixup fold a commit into the one below it." />
        <TextBlock x:Name="Warning" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />

        <ListView x:Name="Rows" MaxHeight="420" SelectionMode="Single"
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True">
            <!-- Stretched, or the subject column collapses: see the star-column trap in CLAUDE.md. -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RebaseRow">
                    <Grid ColumnDefinitions="18,190,72,*" ColumnSpacing="10" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76F;" FontSize="12" Opacity="0.5" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Drag to move" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ActionNames}" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ActionIndex, Mode=TwoWay}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ShortId}" Style="{StaticResource HashTextStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind SubjectVisibility, Mode=OneWay}" />
                            <TextBox Text="{x:Bind Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160"
                                     Visibility="{x:Bind MessageVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="{StaticResource FontSizeCaption}" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="Summary" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
