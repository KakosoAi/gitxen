<Window
    x:Class="Gitxen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Gitxen.Converters"
    xmlns:vm="using:Gitxen.ViewModels"
    xmlns:views="using:Gitxen.Views">

    <!-- The backdrop is set in code, not here: Mica ties the window to the desktop behind it, which
         is right for the themes that mean to look like part of Windows and wrong for the ones that
         commit to their own background colour. See ThemeService.ApplyBackdrop. -->

    <!--
        ZoomHost is the window's real content and is never scaled; RootGrid inside it is. Zooming by
        a render transform alone would scale the pixels and leave the layout at its old size, so the
        window would be drawn larger than it measures and the right and bottom edges would fall
        outside it. Instead RootGrid is given an explicit size of the host divided by the scale and
        then scaled back up, which makes the layout itself happen at the zoomed size. See ApplyZoom.
    -->
    <Grid x:Name="ZoomHost" SizeChanged="ZoomHost_SizeChanged">
        <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto,Auto"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              RenderTransformOrigin="0,0"
              AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ZoomTransform" />
            </Grid.RenderTransform>
        <Grid.Resources>
            <!-- Its Source is assigned in code: a CollectionViewSource is a resource rather than part
                 of the tree, so x:Bind cannot reach the view model from here. -->
            <CollectionViewSource x:Key="GroupedTabsSource" IsSourceGrouped="True" ItemsPath="Items" />
        </Grid.Resources>


        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OpenRepositoryAccelerator_Invoked" />
            <!-- Ctrl+T is the go-to palette, matching a decade of IDE muscle memory. -->
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="GoToAccelerator_Invoked" />
            <!-- Ctrl+K, the quick switcher of chat and editor apps: the launcher, over whatever is open. -->
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="LauncherAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
            <!-- Ctrl+F4 closes a document tab everywhere else on Windows, so it does here too. -->
            <KeyboardAccelerator Modifiers="Control" Key="F4" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="P" Invoked="PaletteAccelerator_Invoked" />
            <!-- The modes have no picker: they are switched from the keyboard, and listed under F1. -->
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number1" Invoked="SimpleModeAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number2" Invoked="AdvancedModeAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="ZenAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
            <KeyboardAccelerator Key="F1" Invoked="ShortcutsAccelerator_Invoked" />
            <!-- F12, where browsers keep their console: the git activity pane. -->
            <KeyboardAccelerator Key="F12" Invoked="ConsoleAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!--
            Custom title bar. The interactive controls sit to the left and the draggable region is the
            empty space to their right: a control inside the element passed to SetTitleBar cannot
            receive input, and the far right of the row belongs to the system caption buttons.

            Opening a repository lives on the Home page rather than here — Home is the first tab and
            cannot be closed, so it is always one click away.
        -->
        <Grid Grid.Row="0" Height="48" Padding="14,0,0,0" ColumnDefinitions="Auto,*"
              ColumnSpacing="14"
              Visibility="{x:Bind ViewModel.ToolbarVisibility, Mode=OneWay}">

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/gitxen-32.png" Width="18" Height="18"
                       VerticalAlignment="Center" />
                <TextBlock Text="Gitxen" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" x:Name="TitleBarDragRegion" Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!--
                The repository column. An alternative to the tab strip rather than an addition: which
                one suits depends on how many repositories are open and how long their names are.
            -->
            <Border x:Name="Sidebar" Grid.Column="0" Width="280"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.SidebarVisibility, Mode=OneWay}">
                <Grid>

                <!-- The column when collapsed: a slim rail keeping the three actions that make sense
                     without names — expand, Home, open. Collapsing rather than hiding, so the way
                     back stays where the column was. -->
                <!--
                    Transparent rather than unpainted: a panel with no background is not hit-tested,
                    so the gaps between the buttons would swallow nothing and the click would fall
                    through to whatever is behind.
                -->
                <StackPanel x:Name="SidebarRail" Visibility="Collapsed" Padding="0,10" Spacing="4"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Expand the repository column"
                            PointerPressed="SidebarRail_PointerPressed">
                    <Button Click="ExpandSidebar_Click" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Expand the repository column"
                            ToolTipService.ToolTip="Expand the repository column">
                        <FontIcon Glyph="&#xE76C;" FontSize="{StaticResource IconSizeSmall}" />
                    </Button>
                    <Button Click="SelectHome_Click" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Home" ToolTipService.ToolTip="Home">
                        <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource IconSizeSmall}" />
                    </Button>
                    <Button Click="AddRepository_Click" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Open a repository"
                            ToolTipService.ToolTip="Open a repository (Ctrl+O)">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSmall}" />
                    </Button>
                </StackPanel>

                <Grid x:Name="SidebarExpanded" RowDefinitions="Auto,Auto,*">

                    <!--
                        The column's own header takes the same three buttons as a project header
                        inside it: left opens, right closes. Its two buttons handle their own pointer
                        events, so a click on either never reaches this.
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,12,12,8"
                                Background="Transparent"
                                ToolTipService.ToolTip="Right-click to collapse the column"
                                PointerPressed="SidebarHeader_PointerPressed">
                        <TextBlock Text="Repositories" Style="{StaticResource SectionCaptionStyle}"
                                   VerticalAlignment="Center" />
                        <Button Click="AddRepository_Click" Padding="6,2"
                                AutomationProperties.Name="Open a repository" ToolTipService.ToolTip="Open a repository (Ctrl+O)">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSmall}" />
                        </Button>
                        <Button Click="CollapseSidebar_Click" Padding="6,2"
                                AutomationProperties.Name="Collapse the repository column"
                                ToolTipService.ToolTip="Collapse the repository column">
                            <FontIcon Glyph="&#xE76B;" FontSize="{StaticResource IconSizeSmall}" />
                        </Button>
                    </StackPanel>

                    <!-- Home sits outside the grouped list: it is not a repository, so it belongs to
                         no project, and keeping it out leaves the list with exactly one selection. -->
                    <Button Grid.Row="1" Click="SelectHome_Click" Margin="8,0,8,6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="Home" />
                        </StackPanel>
                    </Button>

                    <!--
                        Grouped rather than one list per project: nesting lists would give each project
                        its own selection, and the column has to have exactly one.
                    -->
                    <ListView Grid.Row="2" x:Name="SidebarList"
                              ItemsSource="{Binding Source={StaticResource GroupedTabsSource}}"
                              SelectionChanged="SidebarList_SelectionChanged"
                              SelectionMode="Single" Padding="8,0,8,8"
                              ItemContainerStyle="{StaticResource SidebarListViewItemStyle}">
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="False"
                                        HeaderContainerStyle="{StaticResource StretchedGroupHeaderStyle}">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:ShellTabGroup">
                                        <!--
                                            The header's chevron, icon and name line up with the rows
                                            beneath it: same left edge, same icon column width. The
                                            name takes a star column so it ellipsises at whatever
                                            width the column happens to be, and the count sits hard
                                            against the right edge rather than floating.
                                        -->
                                        <!--
                                            The mouse buttons mean one thing each here: left opens
                                            the project, right closes it, middle takes its
                                            repositories off the lists after asking. PointerPressed
                                            rather than Tapped, because only the pointer event says
                                            which button was used.
                                        -->
                                        <Border Background="{x:Bind Tint, Mode=OneWay}" CornerRadius="4"
                                                Padding="4,4,8,4" Margin="0,8,0,2"
                                                HorizontalAlignment="Stretch"
                                                AllowDrop="True" DragOver="SidebarGroup_DragOver"
                                                Drop="SidebarGroup_Drop" Tag="{x:Bind}"
                                                PointerPressed="SidebarGroupHeader_PointerPressed">
                                            <Grid ColumnDefinitions="20,20,*,Auto" ColumnSpacing="6">
                                                <Button Click="ToggleSidebarGroup_Click" Tag="{x:Bind}"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Width="20" Height="20" Padding="0"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{x:Bind ActionsVisibility}"
                                                        AutomationProperties.Name="Collapse or expand"
                                                        ToolTipService.ToolTip="Collapse or expand">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource IconSizeTiny}"
                                                              RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <RotateTransform Angle="{x:Bind ChevronRotation, Mode=OneWay}" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </Button>
                                                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph, Mode=OneWay}"
                                                          FontSize="{StaticResource IconSizeSmall}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{x:Bind Accent, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Name, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind CountText, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarRow">
                                <!--
                                    One row: colour stripe, icon, name over path, close cross. The
                                    text takes a star column so both lines ellipsise against the
                                    column's real width instead of being cut at a guessed one, and
                                    the cross stays on the right edge at every width.
                                -->
                                <Grid ColumnDefinitions="3,20,*,Auto" ColumnSpacing="6" Padding="4,2"
                                      ToolTipService.ToolTip="{x:Bind ToolTipText}"
                                      CanDrag="True" DragStarting="SidebarItem_DragStarting"
                                      PointerPressed="SidebarItem_PointerPressed" Tag="{x:Bind}">
                                    <!-- The cross closes; taking a repository off the lists entirely
                                         is rarer and destructive-ish, so it sits in the context menu
                                         rather than one slip away from Close. -->
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Close repository" Click="CloseRepository_Click"
                                                            Tag="{x:Bind}" Visibility="{x:Bind CloseVisibility}" />
                                            <MenuFlyoutItem Text="Remove from this list" Click="RemoveRepository_Click"
                                                            Tag="{x:Bind}" Visibility="{x:Bind RemoveVisibility}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <!-- The project's colour, so a row is placeable even when its
                                         section header has scrolled out of view. -->
                                    <Border CornerRadius="2" Margin="0,1"
                                            Background="{x:Bind Accent}"
                                            Visibility="{x:Bind GroupVisibility}" />

                                    <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="{StaticResource IconSizeSmall}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Path}" FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="3" Click="CloseRepository_Click" Tag="{x:Bind}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="24" Height="24" Padding="0" VerticalAlignment="Center"
                                            AutomationProperties.Name="Close repository" ToolTipService.ToolTip="Close repository"
                                            Visibility="{x:Bind CloseVisibility}">
                                        <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconSizeTiny}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                <!--
                    The tab strip only. The pages are hosted in row 1 rather than inside the
                    TabViewItem: TabView arranges its content at the content's own desired size
                    instead of filling the area it was given, which left short pages floating in a
                    fraction of the window.

                    A strip is one row, so it cannot show sections the way the column does. Grouping is
                    expressed here by ordering — the view model keeps a project's repositories adjacent
                    — and by the colour stripe each tab carries.
                -->
                <!-- Sized to content so a tab's branch and change count are not cut off by an equal share. -->
                <TabView Grid.Row="0" x:Name="RepositoryTabs" VerticalAlignment="Top"
                         TabWidthMode="SizeToContent"
                         TabItemsSource="{x:Bind ViewModel.StripRows, Mode=OneWay}"
                         SelectionChanged="RepositoryTabs_SelectionChanged"
                         AddTabButtonClick="RepositoryTabs_AddTabButtonClick"
                         TabCloseRequested="RepositoryTabs_TabCloseRequested"
                         Visibility="{x:Bind ViewModel.TabStripVisibility, Mode=OneWay}">
                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarRow">
                            <TabViewItem IsClosable="{x:Bind IsOpen}"
                                         ToolTipService.ToolTip="{x:Bind ToolTipText}">
                                <TabViewItem.IconSource>
                                    <FontIconSource Glyph="{x:Bind Glyph}" />
                                </TabViewItem.IconSource>
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- A project's label: its colour, its name, and while folded how many
                                             tabs are inside it. Clicking it folds or unfolds them. -->
                                        <Border Visibility="{x:Bind LabelVisibility}" CornerRadius="10" Padding="10,2,8,3"
                                                Background="{x:Bind Accent}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind OpenCountText}" Visibility="{x:Bind CollapsedCountVisibility}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.8" />
                                                <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource IconSizeTiny}" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform Angle="{x:Bind LabelChevronRotation}" />
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="3" CornerRadius="2" Margin="0,3"
                                                Background="{x:Bind Accent}"
                                                Visibility="{x:Bind GroupVisibility}"
                                                ToolTipService.ToolTip="{x:Bind GroupName}" />
                                        <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight}"
                                                   VerticalAlignment="Center" Visibility="{x:Bind TabPartsVisibility}" />
                                        <!-- Branch, changes, ahead/behind: whichever Settings turns on. -->
                                        <TextBlock Text="{x:Bind OpenTab.TabDetailText, Mode=OneWay, FallbackValue=''}"
                                                   Visibility="{x:Bind OpenTab.TabDetailVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                    </StackPanel>
                                </TabViewItem.Header>
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.TabItemTemplate>
                </TabView>

                <views:HomeView Grid.Row="1" x:Name="Home"
                                ViewModel="{x:Bind ViewModel}"
                                ActionRequested="Home_ActionRequested"
                                OpenRequested="Home_OpenRequested"
                                Visibility="{x:Bind ViewModel.HomeVisibility, Mode=OneWay}" />

                <views:RepositoryView Grid.Row="1" x:Name="Repository"
                                      Tab="{x:Bind ViewModel.SelectedRepository, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.RepositoryVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!--
            A brief confirmation when a mode is switched from the keyboard. There is no picker to show
            the change, and a shortcut that seems to do nothing is one people stop trusting.
        -->
        <Border Grid.Row="1" x:Name="ModeToast" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                Padding="14,6" CornerRadius="14"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="ModeToastText" FontSize="{StaticResource FontSizeCaption}" />
        </Border>

        <!--
            Zen's way out. Bottom right rather than top right: Zen hides this window's own title bar
            but not the system's caption buttons, and a control under Close is a control nobody can
            press. Faint until it is pointed at, so it states the shortcut without joining the view.
        -->
        <Button Grid.Row="1" x:Name="ZenExit" Click="ZenExit_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                Padding="10,4" Opacity="0.4" CornerRadius="12"
                AutomationProperties.Name="Leave Zen mode"
                ToolTipService.ToolTip="Leave Zen mode (Esc)"
                Visibility="{x:Bind ViewModel.ZenHintVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconSizeTiny}" />
                <TextBlock Text="Zen · Esc" FontSize="{StaticResource FontSizeCaption}" />
            </StackPanel>
        </Button>

        <!--
            The git activity console: every process the app launches, live, with detail for the
            selected one. Docked above the status bar so it belongs to the window, not to any one
            repository — commands run from Home land here too. F12 or the status bar's console
            button toggles it.
        -->
        <views:GitActivityPane x:Name="GitConsole" Grid.Row="2" Height="220" Visibility="Collapsed" />

        <!--
            The status bar: which branch, how far it has diverged, what is uncommitted, and whether
            anything is running — the facts worth knowing from every section, in one strip. Each
            segment jumps to the section that acts on it. On Home it reports the application
            instead: the build, the git it found, and how many repositories it knows.
        -->
        <views:StatusBar Grid.Row="3" x:Name="StatusBarView"
                         Tab="{x:Bind ViewModel.SelectedRepository, Mode=OneWay}"
                         Shell="{x:Bind ViewModel}"
                         SectionRequested="StatusBar_SectionRequested"
                         ConsoleRequested="StatusBar_ConsoleRequested"
                         ZoomRequested="StatusBar_ZoomRequested"
                         Visibility="{x:Bind ViewModel.StatusBarVisibility, Mode=OneWay}" />

        <!--
            The quick launcher: the start screen, and a jump to another repository with Ctrl+K. Across
            the whole window so nothing else shows; below the wizard, which comes first on a first run.
        -->
        <views:QuickLaunch x:Name="Launcher" Grid.RowSpan="4" Visibility="Collapsed"
                           Chosen="Launcher_Chosen" CommitChosen="Launcher_CommitChosen" Dismissed="Launcher_Dismissed" />

        <!--
            The first-run wizard: an overlay across the whole window, title bar row included, so
            nothing behind it can be clicked while it is up. Last child, so it draws over everything
            else. Created collapsed and shown when the session says setup has not been through.
        -->
        <!-- Home's "Add repositories": the repository finder on its own, without the rest of setup. -->
        <views:AddRepositoriesView x:Name="AddRepositories" Grid.RowSpan="4" Visibility="Collapsed"
                                   Completed="AddRepositories_Completed" />

        <views:SetupWizardView x:Name="SetupWizard" Grid.RowSpan="4"
                               Visibility="Collapsed"
                               ThemeChanged="SetupWizard_ThemeChanged"
                               Completed="SetupWizard_Completed" />
        </Grid>
    </Grid>
</Window>
