{
    // The x64 build, which is the one the app actually ships as: a platform-less build writes to a
    // different folder and goes stale without saying so.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Gitxen",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/artifacts/Debug/bin/Gitxen/x64/net10.0-windows10.0.19041.0/Gitxen.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}
